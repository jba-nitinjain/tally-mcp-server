<ENVELOPE>
    <HEADER>
        <TALLYREQUEST>Import Data</TALLYREQUEST>
    </HEADER>
    <BODY>
        <IMPORTDATA>
            <REQUESTDESC>
                <REPORTNAME>Vouchers</REPORTNAME>
                <STATICVARIABLES>
                    {% if targetCompany %}
                    <SVCURRENTCOMPANY>{{ targetCompany | escape }}</SVCURRENTCOMPANY>
                    {% endif %}
                </STATICVARIABLES>
            </REQUESTDESC>
            <REQUESTDATA>
                {% for voucher in vouchers %}
                <TALLYMESSAGE xmlns:UDF="TallyUDF">
                    <VOUCHER {% if voucher.target.kind == "number" %}DATE="{{ voucher.target.date | formatDate("d-MMM-yyyy") }}" TAGNAME="Voucher Number" TAGVALUE="{{ voucher.target.voucherNumber | escape }}"{% else %}REMOTEID="{{ voucher.target.remoteId | escape }}"{% endif %} VCHTYPE="{{ voucher.voucherType | escape }}" ACTION="Delete">
                        <DATE>{{ voucher.date | formatDate("yyyyMMdd") }}</DATE>
                        <VOUCHERTYPENAME>{{ voucher.voucherType | escape }}</VOUCHERTYPENAME>
                    </VOUCHER>
                </TALLYMESSAGE>
                {% endfor %}
            </REQUESTDATA>
        </IMPORTDATA>
    </BODY>
</ENVELOPE>
